<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="16dp"
    android:fillViewport="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <!-- Inner container: the original root LinearLayout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_cyber_bg"
        android:orientation="vertical"
        android:padding="20dp">

    <!-- Top Badge Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_pre_launch_top_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_neon_cyan"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="PRE-LAUNCH DISPLAY PREFERENCE"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_pre_launch_engine_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ANDROID DISPLAY MODES]"
            android:textColor="@color/accent_neon_green"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Game Identity Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_pre_launch_game_icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="Game Icon"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_pre_launch_game_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Game Title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_pre_launch_game_pkg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="com.example.game"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_pre_launch_game_engine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Android game • graphics and FPS are game-controlled"
                android:textColor="@color/accent_neon_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Detected Display Hardware Refresh Rate Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/card_glass_shape"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖥️"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_pre_launch_display_hz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Available display modes"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Target FPS / Refresh Rate Selection Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SELECT A REPORTED DISPLAY MODE:"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_pre_launch_fps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <!-- 185 FPS / Hz -->
        <RadioButton
            android:id="@+id/rb_pre_fps_185"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_glass_shape"
            android:buttonTint="@color/accent_neon_green"
            android:layout_marginBottom="4dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="10dp"
            android:text="Use 185Hz display mode"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 165 FPS / Hz -->
        <RadioButton
            android:id="@+id/rb_pre_fps_165"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_glass_shape"
            android:buttonTint="@color/accent_neon_green"
            android:layout_marginBottom="4dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="10dp"
            android:text="Use 165Hz display mode"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 144 FPS / Hz -->
        <RadioButton
            android:id="@+id/rb_pre_fps_144"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_glass_shape"
            android:buttonTint="@color/accent_neon_green"
            android:layout_marginBottom="4dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="10dp"
            android:text="Use 144Hz display mode"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 120 FPS / Hz -->
        <RadioButton
            android:id="@+id/rb_pre_fps_120"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_glass_shape"
            android:buttonTint="@color/accent_neon_green"
            android:paddingVertical="8dp"
            android:paddingHorizontal="10dp"
            android:text="Use 120Hz display mode"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RadioGroup>

    <!-- Auto-Applied Features Checklist Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_glass_shape"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LAUNCHER BEHAVIOR:"
            android:textColor="@color/accent_neon_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_pre_launch_auto_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="• Uses display modes reported by Android\n• Stores a per-game display preference\n• The game controls its own graphics and frame rate"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 1. MLBB DEDICATED MATRIX SECTION                          -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layout_section_mlbb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- MLBB God Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_glass_shape"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 MLBB God Mode (10k Dmg / 0s CD / God Armor)"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="10,000+ Physical/Magic Dmg, 0s Skill CD, 10x Atk Spd, 10,000 Armor"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_mlbb_god_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- MLBB Drone View -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_glass_shape"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔭 MLBB 100% Drone View (Panoramic Radar)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Season 42 New Map Radar &amp; Camera Elevation Sync (Zero Distortion)"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_mlbb_drone_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- MLBB Drone Tier Selection -->
        <LinearLayout
            android:id="@+id/layout_mlbb_drone_tier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/card_glass_shape"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DRONE ELEVATION TIER:"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_mlbb_drone_tier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_drone_1_5x"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/accent_cyan"
                    android:text="1.5X"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rb_drone_2x"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/accent_cyan"
                    android:text="2.0X"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rb_drone_3x"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/accent_cyan"
                    android:checked="true"
                    android:text="3.0X"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rb_drone_4x"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/accent_cyan"
                    android:text="4.0X"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rb_drone_5x"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/accent_cyan"
                    android:text="5.0X"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- MLBB Hero Script Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_glass_shape"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚔️ MLBB 2026 HERO SCRIPT DISPATCHER:"
                android:textColor="@color/accent_neon_green"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_mlbb_hero_script"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:popupBackground="@drawable/card_glass_shape"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <!-- MLBB Fast Retribution -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_glass_shape"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Fast Retribution Objective Steal"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Instant Lord/Turtle Smite Indicator &amp; Fast Objective Secure"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_mlbb_fast_retri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 2. PUBGM / BGMI DEDICATED MATRIX SECTION                  -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layout_section_pubgm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- PUBGM Zero Recoil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_glass_shape"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 Zero Recoil &amp; Gun Sway Reducer"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Laser Aim Stability • Zero Camera Shake &amp; Bullet Spread Reducer"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_pubgm_zero_recoil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- PUBGM iPad View -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_glass_shape"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 iPad 120° Panoramic Ultra View"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Full Wide Perspective View without Character Distortion"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_pubgm_ipad_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- PUBGM Hit-Reg & Magic Bullet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_glass_shape"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Magic Bullet &amp; Instant Hit-Registration"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Hitbox +35% Expansion &amp; Zero Desync Network Packet Pacing"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_pubgm_magic_bullet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 3. CODM / WARZONE DEDICATED MATRIX SECTION                -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layout_section_codm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- CODM Zero Recoil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_glass_shape"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 CODM Zero Recoil &amp; Anti-Flinch Overdrive"
                    android:textColor="@color/accent_neon_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Weapon Stability Max • No Reticle Drift &amp; Flinch Immunity"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_codm_zero_recoil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- CODM Fast ADS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_glass_shape"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Fast ADS &amp; Instant Weapon Swap"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Turbo Aim-Down-Sights • Instant Sprint-to-Fire Transition"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_codm_fast_ads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- CODM ACE Bypass Cloaking -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_glass_shape"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ ACE Anti-Cheat Cloak &amp; Null Routing"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Suppresses Security Logs &amp; Enforces Hardware Integrity"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_codm_ace_cloak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 4. FREE FIRE DEDICATED MATRIX SECTION                     -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layout_section_freefire"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Free Fire Auto Drag Headshot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_glass_shape"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
