<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/card_glass_shape"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_floating_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ GAME OVERLAY &amp; TRAINER"
        android:textColor="@color/accent_cyan"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_floating_spoof_rog10"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_cyber_dark"
        android:text="🔥 SPOOF ROG 10 PRO+ (165Hz)"
        android:textColor="@color/accent_neon_green"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
